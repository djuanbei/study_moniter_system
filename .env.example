# 学习陪伴系统 - Environment Configuration
# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM API keys ---
# Default provider is minimax (OpenAI-compatible).
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=

# Default provider: minimax | openai | anthropic
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-Text-01
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096

# --- Application ---
# Initial password for the default teacher (`yun`). Must be at least 8 chars.
# install.sh will prompt for this if it is missing.
PASS_WORD=
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=sms_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=720

# Argon2 or bcrypt
PASSWORD_HASH=argon2

# CSRF cookie name
CSRF_COOKIE_NAME=sms_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# --- File storage ---
UPLOAD_DIR=uploads
DATA_DIR=data
LOG_DIR=logs
MAX_UPLOAD_MB=20

# --- OCR ---
# Set to "true" to use vision model; falls back to pytesseract otherwise.
OCR_USE_VISION=false
VISION_MODEL=gpt-4o-mini

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT: text (human-friendly) | json (machine-readable, recommended for production)
# LOG_FILE:  path relative to project root, or absolute. Empty disables file logging.
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=logs/app.log