{
  "app": {
    "name": "学习陪伴系统",
    "default_teacher": {
      "username": "yun",
      "must_change_password": true
    },
    "session_ttl_minutes": 720,
    "max_upload_mb": 20,
    "allowed_image_types": ["jpg", "jpeg", "png", "webp", "pdf"]
  },
  "web": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "jobs": {
    "enabled": true,
    "max_concurrent_heavy_jobs": 1,
    "poll_seconds": 2.0
  },
  "knowledge_base": {
    "incremental_update": {
      "enabled": true,
      "schedule": "weekly",
      "batch_size": 20,
      "auto_publish": false
    }
  },
  "material_agent": {
    "enabled": true,
    "schedule": "weekly",
    "max_candidates_per_run": 50,
    "auto_import": false,
    "search": {
      "provider": "http_json",
      "endpoint": "",
      "query_param": "q",
      "result_path": "results",
      "api_key_env": "",
      "fields": {
        "title": "title",
        "url": "url",
        "snippet": "snippet",
        "license": "license"
      }
    }
  },
  "academic": {
    "school_year_start_month": 9,
    "timezone": "Asia/Shanghai",
    "semesters": {
      "1": { "start": "09-01", "end": "01-15" },
      "2": { "start": "02-15", "end": "07-01" }
    },
    "grade_chapters": {
      "人教版-小学一年级": ["1.1 数与代数", "1.2 图形与几何", "1.3 统计与概率"],
      "人教版-小学二年级": ["2.1 数与代数", "2.2 图形与几何", "2.3 统计与概率"],
      "人教版-小学三年级": ["3.1 数与代数", "3.2 图形与几何", "3.3 统计与概率"],
      "人教版-小学四年级": ["4.1 大数的认识", "4.2 三位数乘两位数", "4.3 角的度量", "4.4 平行四边形和梯形"],
      "人教版-小学五年级": ["5.1 小数乘法", "5.2 位置", "5.3 小数除法", "5.4 可能性", "5.5 简易方程", "5.6 多边形的面积"],
      "人教版-小学六年级": ["6.1 分数乘法", "6.2 位置与方向", "6.3 分数除法", "6.4 比", "6.5 圆", "6.6 百分数"],
      "人教版-初一": ["7.1 有理数", "7.2 整式的加减", "7.3 一元一次方程", "7.4 几何图形初步"],
      "人教版-初二": ["8.1 三角形", "8.2 全等三角形", "8.3 轴对称", "8.4 整式的乘法与因式分解"],
      "人教版-初三": ["9.1 二次根式", "9.2 一元二次方程", "9.3 旋转", "9.4 圆", "9.5 概率初步"],
      "人教版-高一": ["10.1 集合与函数", "10.2 三角函数", "10.3 平面向量", "10.4 数列", "10.5 不等式", "10.6 立体几何初步"],
      "人教版-高二": ["11.1 三角恒等变换", "11.2 解三角形", "11.3 直线与方程", "11.4 圆与方程", "11.5 概率与统计", "11.6 空间向量"],
      "人教版-高三": ["12.1 导数与微分", "12.2 导数应用", "12.3 计数原理", "12.4 概率分布", "12.5 统计案例", "12.6 复数"]
    }
  },
  "generation": {
    "frequency": "weekly",
    "default_question_count": 6,
    "default_difficulty": "medium",
    "sets_per_request": 2,
    "max_calculation_intensity": "light",
    "diagram_format": "svg",
    "retry_on_failure": true
  },
  "llm": {
    "provider": "minimax",
    "model": "MiniMax-Text-01",
    "temperature": 0.4,
    "max_tokens": 4096,
    "validator_strict": true,
    "duplicate_window_days": 14
  },
  "uploads": {
    "path": "data/students/{student_id}/submissions/{assignment_id}/{timestamp}",
    "keep_original_filename": false,
    "compute_sha256": true
  }
}